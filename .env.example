# Copy this file to .env and fill in whichever key matches the providers you
# set in config.yaml (llm.provider, stt.provider, tts.provider). You only
# need the ones you're actually using -- e.g. if config.yaml has
# llm.provider: anthropic and stt.provider: faster_whisper, you only need
# ANTHROPIC_API_KEY; nothing else in this file matters.
#
# run.py loads this automatically. Never commit the real .env -- it's
# gitignored already, and it should stay that way.

# llm.provider: openai | stt.provider: openai_whisper | tts.provider: openai
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# llm.provider: anthropic
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# llm.provider: gemini
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# llm.provider: ollama needs no key -- it's local. Just have Ollama running.
